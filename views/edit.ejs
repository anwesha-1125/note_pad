<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
  <div class = "main w-full min-h-screen bg-zinc-900 p-10">
    <a class="text-blue-500 inline-block mt-3" href="/">Back to home</a>
    <div class="form p-10 text-white" >
      <form action="/edit/<%= filename %>" method="post">
          <input class="block px-5 py-2 w-full rounded-lg bg-zinc-800 " type="text" name="title" placeholder="
          previous name" value="<%= filename %>"readonly>  
          <br/>
          <input class="block px-5 py-2 w-full rounded-lg bg-zinc-800" type="text" name="edittitle" placeholder="new name" >
          <br/>
          <br/>
          <textarea class="block px-5 py-2 mt-2 w-full rounded-lg resize-none bg-zinc-800" name="details" placeholder="Edit task details here..."><%= data %></textarea>
          <input class="mt-2 bg-yellow-600 px-5 py-2 rounded-md" type="submit" value="Update Task">
      </form>
  </div>
</body>
</html>